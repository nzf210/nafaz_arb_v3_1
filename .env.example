# =========================================================
# 1. RUNTIME & MODE (Burn-In / Canary / Full Live)
# =========================================================
# Set DRY_RUN=true for shadow/burn-in mode (no real orders placed).
# Set DRY_RUN=false for Canary / Live execution.
DRY_RUN=true
CEX_SANDBOX=false
CANARY_MAX_NOTIONAL_USDT=20.0
WATCHDOG_INTERVAL_SEC=15

# =========================================================
# 2. INFRASTRUCTURE (Redis Event Bus & PostgreSQL Persistence)
# =========================================================
REDIS_ADDR=127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379/0

POSTGRES_USER=nafaz
POSTGRES_PASSWORD=nafaz_secret
POSTGRES_DB=nafaz_arb
DATABASE_URL=postgresql://nafaz:nafaz_secret@nafaz_postgres:5432/nafaz_arb

# =========================================================
# 3. CEX API CREDENTIALS (Trade permission ONLY, NEVER Withdraw)
# =========================================================
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

BYBIT_API_KEY=
BYBIT_API_SECRET=

MEXC_API_KEY=
MEXC_API_SECRET=

# =========================================================
# 4. TELEGRAM BOT & NOTIFICATIONS (Two-Way Interactive & Alerts)
# =========================================================
TELEGRAM_BOT_TOKEN=
# Chat ID (Pribadi: 123456789, Grup: -1002345678901)
TELEGRAM_CHAT_ID=
# Opsional: Chat ID grup tambahan (dipisahkan koma)
TELEGRAM_ALLOWED_CHAT_IDS=
# Opsional: User ID operator untuk aksi sensitif (/set, /killswitch, /balance, force close).
# Jika kosong, semua member di grup yang terdaftar di atas dapat mengeksekusi.
TELEGRAM_ALLOWED_USER_IDS=
# Opsional: Custom Telegram API proxy (cth: https://my-tg-proxy.workers.dev atau http://127.0.0.1:8081)
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Opsional: HTTP/HTTPS proxy jika VPS memblokir Telegram langsung
HTTPS_PROXY=
