# =========================================================
# 1. RUNTIME & MODE (Burn-In / Canary / Full Live)
# =========================================================
# Set DRY_RUN=true for shadow/burn-in mode (no real orders placed).
# Set DRY_RUN=false for Canary / Live execution.
DRY_RUN=true
CEX_SANDBOX=false
CANARY_MAX_NOTIONAL_USDT=20.0
WATCHDOG_INTERVAL_SEC=15

# =========================================================
# 2. INFRASTRUCTURE (Redis Event Bus & PostgreSQL Persistence)
# =========================================================
REDIS_ADDR=redis:6379
REDIS_URL=redis://redis:6379/0

POSTGRES_USER=nafaz
POSTGRES_PASSWORD=nafaz_secret
POSTGRES_DB=nafaz_arb
DATABASE_URL=postgresql://nafaz:nafaz_secret@postgres:5432/nafaz_arb

# =========================================================
# 3. CEX API CREDENTIALS (Trade permission ONLY, NEVER Withdraw)
# =========================================================
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

BYBIT_API_KEY=
BYBIT_API_SECRET=

MEXC_API_KEY=
MEXC_API_SECRET=

# =========================================================
# 4. TELEGRAM ALERTING (Risk Watchdog & Kill-Switch)
# =========================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
