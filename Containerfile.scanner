# Build stage
FROM docker.io/library/golang:1.23-alpine AS builder
WORKDIR /src/scanner-go
COPY scanner-go/go.mod scanner-go/go.sum ./
RUN go mod download
COPY scanner-go/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/scanner ./cmd/scanner

# Runtime stage
FROM docker.io/library/alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /out/scanner /app/scanner
COPY configs/ /app/configs/
ENV SCANNER_CONFIG=/app/configs/scanner.base.yaml \
    EXCHANGES_CONFIG=/app/configs/exchanges.yaml
ENTRYPOINT ["/app/scanner"]
